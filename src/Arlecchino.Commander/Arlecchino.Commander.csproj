<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Arlecchino.Commander</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Compiled ahead of time for the releases, so this code is held to it on every build: anything
         of ours that reflection would only find at runtime fails here rather than on someone's disk. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- FluentFTP trips two trim checks of its own: a version banner that asks for its own method,
         and a stream type it would build from a name this application never sets. Neither path is
         reachable from here, and neither is ours to fix; ours are caught by the line above. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ArlecchinoViewNamespace>Arlecchino.Commander.Views</ArlecchinoViewNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arlecchino" Version="2.9.0" />
    <PackageReference Include="FluentFTP" Version="54.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
  </ItemGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="ArlecchinoViewNamespace" />
    <CompilerVisibleProperty Include="ArlecchinoGenerateViews" />
    <CompilerVisibleProperty Include="ArlecchinoGenerateStores" />
    <CompilerVisibleProperty Include="ArlecchinoGenerateWidgets" />
    <CompilerVisibleProperty Include="ArlecchinoGenerateCommands" />
  </ItemGroup>

</Project>
