<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Arlecchino.Commander</RootNamespace>
    <AssemblyName>arlc</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ArlecchinoViewNamespace>Arlecchino.Commander.Views</ArlecchinoViewNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../lib/Arlecchino/src/Arlecchino/Arlecchino.csproj" />
    <ProjectReference Include="../../lib/Arlecchino/src/Arlecchino.Pictures/Arlecchino.Pictures.csproj" />
    <ProjectReference Include="../../lib/Arlecchino/src/Arlecchino.Generators/Arlecchino.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="ArlecchinoViewNamespace" />
    <CompilerVisibleProperty Include="ArlecchinoGenerateViews" />
    <CompilerVisibleProperty Include="ArlecchinoGenerateStores" />
    <CompilerVisibleProperty Include="ArlecchinoGenerateWidgets" />
    <CompilerVisibleProperty Include="ArlecchinoGenerateCommands" />
    <CompilerVisibleProperty Include="ArlecchinoLocalizationFolder" />
    <CompilerVisibleProperty Include="ArlecchinoLocalizationLanguage" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Arlecchino.Commander.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Localization\*.toml" />
  </ItemGroup>

</Project>
