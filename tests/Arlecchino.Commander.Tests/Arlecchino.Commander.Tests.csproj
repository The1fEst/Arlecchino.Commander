<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Arlecchino.Commander.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Library rules, on the library. A test formats strings it never shows anyone and holds
         disposables for the length of one fact, so the recommended set is noise here. -->
    <AnalysisLevel>latest-default</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arlecchino.Testing" Version="3.1.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Arlecchino.Commander/Arlecchino.Commander.csproj" />
  </ItemGroup>
</Project>
